rules_version = '2';

// Each user can read and change only their own document, which holds
// nothing but a non-negative loyalty point balance. Everything else is
// closed.
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow create, update: if request.auth != null
        && request.auth.uid == userId
        && request.resource.data.keys().hasOnly(['loyaltyPoints'])
        && request.resource.data.loyaltyPoints is int
        && request.resource.data.loyaltyPoints >= 0;
    }
  }
}
